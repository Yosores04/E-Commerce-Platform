# Laravel specific
/marketplace/vendor/
/marketplace/node_modules/
/marketplace/public/hot
/marketplace/public/storage
/marketplace/storage/*.key
/marketplace/.env
/marketplace/.env.backup
/marketplace/.env.production
/marketplace/.phpunit.result.cache
/marketplace/Homestead.json
/marketplace/Homestead.yaml
/marketplace/auth.json
/marketplace/npm-debug.log
/marketplace/yarn-error.log
/marketplace/.fleet
/marketplace/.idea
