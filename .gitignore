# Laravel storage
/marketplace/storage/framework/cache/data/*
/marketplace/storage/framework/sessions/*
/marketplace/storage/framework/views/*
/marketplace/storage/logs/*

# Keep directory structure
!/marketplace/storage/app/.gitignore
!/marketplace/storage/framework/.gitignore
!/marketplace/storage/logs/.gitignore

# Documentation (keep local only)
*.md
!README.md

# OS specific
.DS_Store
Thumbs.db
*.swp
*.swo
*~

